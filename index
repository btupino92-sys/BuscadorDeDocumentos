<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscador Consolidado de Documentos</title>
    <!-- Tailwind CSS para un diseño limpio y profesional -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Librería SheetJS para leer archivos Excel y CSV en el navegador -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen p-6">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Encabezado -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Buscador Institucional Consolidado</h1>
                <p class="text-sm text-gray-500">Sube tus archivos Excel o arrástralos para buscar de inmediato en toda la matriz.</p>
            </div>
            
            <!-- Selector de Archivos -->
            <label class="cursor-pointer bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg shadow transition flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Cargar Archivos Excel
                <input type="file" id="inputFiles" multiple accept=".xlsx, .xls, .csv" class="hidden" />
            </label>
        </div>

        <!-- Buscador y Contador -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="w-full sm:w-96 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text" id="buscador" placeholder="Escribe para buscar en cualquier columna..." 
                    class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>
            <div class="text-sm text-gray-500 font-medium" id="contadorResultados">
                Mostrando 0 registros
            </div>
        </div>

        <!-- Tabla de Resultados -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto max-h-[600px]">
                <table class="w-full text-left border-collapse" id="tablaMatriz">
                    <thead class="bg-gray-100 text-gray-700 text-xs uppercase font-semibold sticky top-0 z-10" id="tablaEncabezado">
                        <!-- Los encabezados se generan dinámicamente -->
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm text-gray-600" id="tablaCuerpo">
                        <tr>
                            <td colspan="100" class="text-center py-12 text-gray-400">
                                Sube o selecciona uno o más archivos Excel para comenzar la consolidación.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Script de lógica de consolidación y búsqueda -->
    <script>
        let datosGlobales = [];
        let encabezadosGlobales = [];

        document.getElementById('inputFiles').addEventListener('change', async function(e) {
            const archivos = e.target.files;
            if (archivos.length === 0) return;

            datosGlobales = [];
            encabezadosGlobales = [];
            let promesas = [];

            for (let i = 0; i < archivos.length; i++) {
                let archivo = archivos[i];
                promesas.push(leerArchivoExcel(archivo));
            }

            await Promise.all(promesas);
            renderizarTabla(datosGlobales);
        });

        function leerArchivoExcel(archivo) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });

                        // Leer todas las pestañas del archivo
                        workbook.SheetNames.forEach(nombrePestaña => {
                            const worksheet = workbook.Sheets[nombrePestaña];
                            const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                            if (json.length > 0) {
                                // Definir encabezados de la primera pestaña válida encontrada si aún no existen
                                if (encabezadosGlobales.length === 0 && json[0]) {
                                    encabezadosGlobales = [...json[0], "Archivo Origen"];
                                }

                                // Recorrer filas omitiendo el encabezado (i = 1)
                                for (let i = 1; i < json.length; i++) {
                                    let fila = json[i];
                                    if (fila && fila.some(celda => celda !== "")) {
                                        // Asegurar 16 columnas o rellenar si faltan, y agregar el nombre del archivo
                                        while(fila.length < (encabezadosGlobales.length - 1)) {
                                            fila.push("");
                                        }
                                        fila.push(archivo.name);
                                        datosGlobales.push(fila);
                                    }
                                }
                            }
                        });
                    } catch (err) {
                        console.error("Error leyendo " + archivo.name, err);
                    }
                    resolve();
                };
                reader.readAsArrayBuffer(archivo);
            });
        }

        function renderizarTabla(datos) {
            const thead = document.getElementById('tablaEncabezado');
            const tbody = document.getElementById('tablaCuerpo');
            const contador = document.getElementById('contadorResultados');

            thead.innerHTML = '';
            tbody.innerHTML = '';

            if (encabezadosGlobales.length === 0) {
                tbody.innerHTML = `<tr><td colspan="100" class="text-center py-12 text-gray-400">No se encontraron datos válidos en los archivos.</td></tr>`;
                contador.innerText = "Mostrando 0 registros";
                return;
            }

            // Crear encabezados
            let trHead = document.createElement('tr');
            encabezadosGlobales.forEach(col => {
                let th = document.createElement('th');
                th.className = "px-4 py-3 border-b border-gray-200 whitespace-nowrap";
                th.innerText = col;
                trHead.appendChild(th);
            });
            thead.appendChild(trHead);

            // Crear filas
            if (datos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="100" class="text-center py-12 text-gray-400">No hay coincidencias con la búsqueda.</td></tr>`;
                contador.innerText = "Mostrando 0 registros";
                return;
            }

            let fragmento = document.createDocumentFragment();
            datos.forEach(fila => {
                let tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50 transition border-b border-gray-100";
                
                // Rellenar celdas de la fila
                for (let j = 0; j < encabezadosGlobales.length; j++) {
                    let td = document.createElement('td');
                    td.className = "px-4 py-3 whitespace-nowrap text-gray-700";
                    td.innerText = fila[j] !== undefined ? fila[j] : "";
                    tr.appendChild(td);
                }
                fragmento.appendChild(tr);
            });

            tbody.appendChild(fragmento);
            contador.innerText = `Mostrando ${datos.length} registros consolidados`;
        }

        // Lógica del Buscador en tiempo real
        document.getElementById('buscador').addEventListener('input', function(e) {
            const textoBusqueda = e.target.value.toLowerCase();
            
            const datosFiltrados = datosGlobales.filter(fila => {
                return fila.some(celda => String(celda).toLowerCase().includes(textoBusqueda));
            });

            renderizarTabla(datosFiltrados);
        });
    </script>
</body>
</html>
